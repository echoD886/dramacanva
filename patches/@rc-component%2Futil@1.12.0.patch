@@ -1,6 +1,7 @@
 /* eslint-disable no-param-reassign */
 import { removeCSS, updateCSS } from "./Dom/dynamicCSS";
 let cached;
+const targetSizes = new Map();
 function measureScrollbarSize(ele) {
   const randomId = `rc-scrollbar-measure-${Math.random().toString(36).substring(7)}`;
   const measureEle = document.createElement('div');
@@ -76,5 +77,11 @@ export function getTargetScrollBarSize(target) {
       height: 0
     };
   }
-  return measureScrollbarSize(target);
+  // The measurement clones only these styles. Reuse that result instead of
+  // inserting a temporary stylesheet and invalidating the entire document.
+  const style = getComputedStyle(target);
+  const pseudo = getComputedStyle(target, '::-webkit-scrollbar');
+  const key = JSON.stringify([style.scrollbarColor, style.scrollbarWidth, pseudo.width, pseudo.height, window.devicePixelRatio]);
+  if (!targetSizes.has(key)) targetSizes.set(key, measureScrollbarSize(target));
+  return targetSizes.get(key);
 }
